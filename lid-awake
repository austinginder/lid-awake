#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
REPO="austinginder/lid-awake"
STATE="${LID_AWAKE_STATE:-$HOME/.lid-awake}"
UPDATE_CACHE="$HOME/Library/Caches/lid-awake/latest-version"
UPDATE_INTERVAL=86400
DEFAULT_SLEEP=5
MENUBAR_APP_PATH="$HOME/Applications/Lid Awake.app"

usage() {
  cat <<'EOF'
lid-awake — keep a MacBook awake with the lid closed on battery

Usage:
  lid-awake                 Toggle stay-awake on/off
  lid-awake on              Enable
  lid-awake off             Restore saved sleep settings
  lid-awake status          Show current state
  lid-awake update          Install the latest release from GitHub
  lid-awake update --check  Check for a new release without installing
  lid-awake menubar enable  Build, install, and launch the menu bar app
  lid-awake menubar disable Quit and remove the menu bar app
  lid-awake version         Show the installed version
  lid-awake help            Show this help

Requires macOS. pmset needs admin access (sudo in Terminal, or a password
dialog from the menu bar). While on, the Mac does not sleep at all; the
battery sleep timer is saved and restored, AC settings are left alone.
Do not leave this on in a bag — a closed lid traps heat.
EOF
}

die() {
  echo "❌ $*" >&2
  exit 1
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  echo "$(cd "$(dirname "$source")" && pwd)/$(basename "$source")"
}

sleep_disabled() {
  pmset -g | awk '/SleepDisabled/ { gsub(/[^0-9]/, ""); print; exit }'
}

battery_sleep() {
  pmset -g custom | awk '
    /^Battery Power:/ { in_batt = 1; next }
    /^[A-Z]/ { in_batt = 0 }
    in_batt && $1 == "sleep" { print $2; exit }
  '
}

is_on() {
  [[ "$(sleep_disabled)" == "1" ]]
}

saved_sleep() {
  local saved=""
  [[ -f "$STATE" ]] && saved="$(<"$STATE")"
  [[ "$saved" =~ ^[0-9]+$ ]] && echo "$saved"
  return 0
}

# Run a command as root: sudo in a terminal, the macOS password dialog from
# the menu bar (or anything else without a TTY).
run_as_admin() {
  local prompt="$1"
  shift
  if [[ "$EUID" -eq 0 ]]; then
    "$@"
  elif [[ "${LID_AWAKE_GUI:-}" == "1" ]] || [[ ! -t 0 ]]; then
    osascript - "$prompt" "$@" >/dev/null <<'APPLESCRIPT'
on run argv
  set command to ""
  repeat with i from 2 to count of argv
    set command to command & quoted form of (item i of argv) & " "
  end repeat
  do shell script command with administrator privileges with prompt (item 1 of argv)
end run
APPLESCRIPT
  else
    sudo "$@"
  fi
}

run_pmset() {
  run_as_admin "Lid Awake wants to change power settings." "$(command -v pmset)" -b "$@"
}

enable_awake() {
  if is_on; then
    echo "☕️ Lid-closed stay-awake already ON (battery)"
    return
  fi
  local current saved
  current="$(battery_sleep)"
  saved="$(saved_sleep)"
  # A saved timer means the last session never restored it (disablesleep was
  # reset some other way). Keep it rather than saving the 0 left behind.
  if [[ ! "$current" =~ ^[0-9]+$ ]]; then
    current="${saved:-$DEFAULT_SLEEP}"
  elif [[ "$current" == "0" && -n "$saved" ]]; then
    current="$saved"
  fi
  run_pmset sleep 0 disablesleep 1
  echo "$current" > "$STATE"
  echo "☕️ Lid-closed stay-awake ON (battery)"
  echo "   sleep 0, disablesleep 1 — don't leave this on in a bag"
}

disable_awake() {
  local current saved restore
  current="$(battery_sleep)"
  saved="$(saved_sleep)"
  if ! is_on; then
    # Already off. The one thing left to fix is a battery timer still at the
    # 0 a previous session left behind.
    if [[ -z "$saved" || "$current" != "0" ]]; then
      rm -f "$STATE"
      echo "😴 Lid-closed stay-awake already OFF"
      return
    fi
  fi
  restore="$saved"
  if [[ -z "$restore" ]]; then
    if [[ "$current" =~ ^[1-9][0-9]*$ ]]; then
      restore="$current"
    else
      restore="$DEFAULT_SLEEP"
    fi
  fi
  run_pmset sleep "$restore" disablesleep 0
  rm -f "$STATE"
  echo "😴 Lid-closed stay-awake OFF"
  echo "   Restored battery sleep to ${restore} min, disablesleep 0"
}

show_status() {
  local batt
  batt="$(battery_sleep)"
  batt="${batt:-unknown}"
  if [[ "${1:-}" == "--porcelain" ]]; then
    if is_on; then
      echo "state=on"
      echo "sleep=0"
    else
      echo "state=off"
      echo "sleep=${batt}"
    fi
    echo "version=${VERSION}"
    return
  fi
  if is_on; then
    echo "☕️ Lid-closed stay-awake is ON (battery)"
    echo "   sleep 0, disablesleep 1"
  else
    echo "😴 Lid-closed stay-awake is OFF"
    echo "   battery sleep ${batt} min, disablesleep 0"
    local saved
    saved="$(saved_sleep)"
    if [[ "$batt" == "0" && -n "$saved" ]]; then
      echo "   Battery sleep was ${saved} min before. Restore it with: lid-awake off"
    fi
  fi
}

# --- Updates -----------------------------------------------------------------

valid_version() {
  [[ "${1:-}" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]
}

# True when version $1 is newer than $2, comparing each part as a number.
version_gt() {
  local IFS=.
  local -a a=($1) b=($2)
  local i x y
  for i in 0 1 2; do
    x="${a[i]:-0}"
    y="${b[i]:-0}"
    if ((10#$x > 10#$y)); then return 0; fi
    if ((10#$x < 10#$y)); then return 1; fi
  done
  return 1
}

# GitHub redirects releases/latest to releases/tag/v<version>. One HEAD
# request, no API token, no rate limit, no JSON.
fetch_latest_version() {
  local location tag
  location="$(curl -fsSI -o /dev/null -w '%{redirect_url}' --max-time 10 \
    "https://github.com/${REPO}/releases/latest")" || return 1
  tag="${location##*/}"
  valid_version "${tag#v}" || return 1
  echo "${tag#v}"
}

write_update_cache() {
  mkdir -p "$(dirname "$UPDATE_CACHE")"
  printf '%s\n%s\n' "$(date +%s)" "$1" > "$UPDATE_CACHE.tmp.$$"
  mv -f "$UPDATE_CACHE.tmp.$$" "$UPDATE_CACHE"
}

refresh_update_cache() {
  local latest
  latest="$(fetch_latest_version)" || return 1
  write_update_cache "$latest"
}

# After a command run in a terminal: say if a newer release is known, and
# refresh that knowledge in the background at most once a day.
maybe_notify_update() {
  [[ -t 1 ]] || return 0
  [[ "${LID_AWAKE_NO_UPDATE_CHECK:-}" == "1" ]] && return 0
  local checked=0 latest=""
  if [[ -f "$UPDATE_CACHE" ]]; then
    { read -r checked && read -r latest; } < "$UPDATE_CACHE" || true
  fi
  [[ "$checked" =~ ^[0-9]+$ ]] || checked=0
  if (($(date +%s) - checked >= UPDATE_INTERVAL)); then
    (trap '' HUP; refresh_update_cache) >/dev/null 2>&1 &
  fi
  if valid_version "$latest" && version_gt "$latest" "$VERSION"; then
    echo ""
    echo "⬆️  Lid Awake v${latest} is available (you have v${VERSION}). Run: lid-awake update"
  fi
  return 0
}

update_check() {
  local latest
  latest="$(fetch_latest_version)" || die "Could not find the latest release on GitHub."
  write_update_cache "$latest"
  if version_gt "$latest" "$VERSION"; then
    echo "⬆️  Lid Awake v${latest} is available (you have v${VERSION})"
    echo "   Release notes: https://github.com/${REPO}/releases/tag/v${latest}"
    echo "   Install it with: lid-awake update"
  else
    echo "✅ Lid Awake v${VERSION} is up to date"
  fi
}

update_install() {
  echo "🔎 Checking for the latest release of Lid Awake..."
  local latest
  latest="$(fetch_latest_version)" || die "Could not find the latest release on GitHub."
  write_update_cache "$latest"

  local script_path script_dir menubar_dir=""
  script_path="$(resolve_script_path)"
  script_dir="$(dirname "$script_path")"
  menubar_dir="$(menubar_src_dir)" || menubar_dir=""

  if ! version_gt "$latest" "$VERSION"; then
    echo "✅ Lid Awake v${VERSION} is up to date"
    if menubar_is_enabled && [[ "$(menubar_installed_version)" != "$VERSION" ]]; then
      echo "   The menu bar app is older than the CLI. Rebuilding it..."
      echo ""
      menubar_enable
    fi
    return
  fi

  if [[ -e "$script_dir/.git" ]]; then
    echo "⬆️  Lid Awake v${latest} is available (you have v${VERSION})"
    echo "   This copy is a git checkout. Update it with:"
    echo "   git -C $(printf '%q' "$script_dir") pull"
    if menubar_is_enabled; then
      echo "   then rebuild the menu bar app: lid-awake menubar enable"
    fi
    exit 1
  fi

  echo "   Installed: v${VERSION}"
  echo "   Latest:    v${latest}"

  local tmp
  tmp="$(mktemp -d)"
  trap "rm -rf $(printf '%q' "$tmp")" EXIT

  # The release's lid-awake.zip is what GitHub counts as a download. A release
  # published without one still updates, from GitHub's source tarball.
  local src new_version
  echo "⬇️  Downloading v${latest}..."
  mkdir -p "$tmp/unpacked"
  if curl -fsSL --max-time 120 -o "$tmp/lid-awake.zip" \
      "https://github.com/${REPO}/releases/download/v${latest}/lid-awake.zip"; then
    unzip -q "$tmp/lid-awake.zip" -d "$tmp/unpacked" || die "Could not unpack the download."
    src="$tmp/unpacked/lid-awake"
  else
    curl -fsSL --max-time 120 -o "$tmp/release.tar.gz" \
      "https://github.com/${REPO}/archive/refs/tags/v${latest}.tar.gz" \
      || die "Download failed. Check your connection and try again."
    tar -xzf "$tmp/release.tar.gz" -C "$tmp/unpacked" || die "Could not unpack the download."
    src="$tmp/unpacked/lid-awake-${latest}"
  fi
  [[ -f "$src/lid-awake" ]] || die "The download does not contain lid-awake."
  bash -n "$src/lid-awake" || die "The downloaded lid-awake did not pass a syntax check."
  new_version="$(sed -n 's/^VERSION="\(.*\)"$/\1/p' "$src/lid-awake" | head -n 1)"
  [[ "$new_version" == "$latest" ]] \
    || die "The download reports v${new_version:-unknown}, expected v${latest}."

  # The new script goes in beside the old one and is renamed over it, so this
  # running copy keeps reading the file it started from.
  cat > "$tmp/install.sh" <<'INSTALL'
set -euo pipefail
src="$1" script="$2" menubar="$3"
next="$(dirname "$script")/.lid-awake.next.$$"
cp "$src/lid-awake" "$next"
chmod 755 "$next"
mv -f "$next" "$script"
if [[ -n "$menubar" ]]; then
  cp -R "$src/menubar/." "$menubar/"
fi
INSTALL

  local needs_admin=0 file
  [[ -w "$script_dir" ]] || needs_admin=1
  if [[ -n "$menubar_dir" ]]; then
    while IFS= read -r -d '' file; do
      [[ -w "$file" ]] || needs_admin=1
    done < <(find "$menubar_dir" -print0)
  fi

  echo "📦 Installing to ${script_path}..."
  if ((needs_admin)); then
    run_as_admin "Lid Awake wants to install an update." \
      /bin/bash "$tmp/install.sh" "$src" "$script_path" "$menubar_dir"
  else
    /bin/bash "$tmp/install.sh" "$src" "$script_path" "$menubar_dir"
  fi
  rm -rf "$tmp"
  trap - EXIT

  echo "✅ Lid Awake updated to v${latest}"
  echo "   Release notes: https://github.com/${REPO}/releases/tag/v${latest}"

  if menubar_is_enabled; then
    echo ""
    "$script_path" menubar enable
  fi
}

update_cmd() {
  case "${1:-}" in
    "") update_install ;;
    --check) update_check ;;
    *)
      echo "Usage: lid-awake update [--check]" >&2
      exit 1
      ;;
  esac
}

# --- Menu bar ----------------------------------------------------------------

menubar_src_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "$(resolve_script_path)")" && pwd)"
  if [[ -f "$script_dir/menubar/Sources/main.m" ]]; then
    echo "$script_dir/menubar"
    return
  fi
  if [[ -f "$script_dir/../share/lid-awake/menubar/Sources/main.m" ]]; then
    (cd "$script_dir/../share/lid-awake/menubar" && pwd)
    return
  fi
  return 1
}

menubar_installed_version() {
  /usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" \
    "$MENUBAR_APP_PATH/Contents/Info.plist" 2>/dev/null || true
}

menubar_is_enabled() {
  [[ -d "$MENUBAR_APP_PATH" ]]
}

menubar_usage() {
  cat <<EOF
Usage: lid-awake menubar <subcommand>

Build a native macOS menu bar app on this machine (clang + system
frameworks, no notarization). The icon shows whether lid-closed stay-awake
is on, and the menu can toggle it.

Subcommands:
  enable     Build, install, and launch the menu bar app (also updates it)
  disable    Quit and remove the menu bar app

EOF
  local installed
  installed="$(menubar_installed_version)"
  if menubar_is_enabled; then
    echo "Currently: enabled (v${installed:-unknown})"
    if [[ "$installed" != "$VERSION" ]]; then
      echo "The CLI is v${VERSION}. Rebuild with: lid-awake menubar enable"
    fi
  else
    echo "Currently: disabled"
  fi
}

menubar_enable() {
  [[ "$EUID" -ne 0 ]] || die "Run lid-awake menubar enable without sudo. The app installs into your own ~/Applications."

  if ! command -v clang >/dev/null || ! xcode-select -p >/dev/null 2>&1; then
    die "Apple Command Line Tools are required to build the menu bar app.
   Install them with: xcode-select --install"
  fi

  local src
  src="$(menubar_src_dir)" || die "Menu bar sources not found. Run this from a lid-awake checkout, or reinstall with make install."

  local script_path bin_literal
  script_path="$(resolve_script_path)"
  bin_literal="${script_path//\\/\\\\}"
  bin_literal="${bin_literal//\"/\\\"}"

  local build_dir
  build_dir="$(mktemp -d)"
  trap "rm -rf $(printf '%q' "$build_dir")" EXIT

  echo "🛠️  Building Lid Awake menu bar v${VERSION}..."

  cp "$src/Sources/main.m" "$build_dir/main.m"
  sed "s/__MENUBAR_VERSION__/${VERSION}/g" "$src/Resources/Info.plist" > "$build_dir/Info.plist"
  cp "$src/Resources/Assets/lid-awake.svg" "$build_dir/lid-awake.svg"

  if ! clang \
      -fobjc-arc \
      -O2 \
      -Wall \
      -Wextra \
      -mmacosx-version-min=13.0 \
      -DLID_AWAKE_BIN="\"${bin_literal}\"" \
      -framework Cocoa \
      -framework CoreImage \
      -framework ServiceManagement \
      "$build_dir/main.m" \
      -o "$build_dir/LidAwake"; then
    die "Failed to compile the menu bar app."
  fi

  local iconset_dir="$build_dir/LidAwake.iconset"
  mkdir -p "$iconset_dir"
  if ! sips -s format png -z 16 16 "$build_dir/lid-awake.svg" \
        --out "$build_dir/icon-probe.png" >/dev/null 2>&1 \
      || ! sips -g pixelWidth "$build_dir/icon-probe.png" >/dev/null 2>&1; then
    die "This macOS could not rasterize the menu bar icon (SVG via sips)."
  fi
  local spec size name
  for spec in \
      "16 icon_16x16.png" \
      "32 icon_16x16@2x.png" \
      "32 icon_32x32.png" \
      "64 icon_32x32@2x.png" \
      "128 icon_128x128.png" \
      "256 icon_128x128@2x.png" \
      "256 icon_256x256.png" \
      "512 icon_256x256@2x.png" \
      "512 icon_512x512.png" \
      "1024 icon_512x512@2x.png"; do
    size="${spec%% *}"
    name="${spec#* }"
    sips -s format png -z "$size" "$size" "$build_dir/lid-awake.svg" \
      --out "$iconset_dir/$name" >/dev/null
  done
  iconutil -c icns "$iconset_dir" -o "$build_dir/LidAwake.icns"

  pkill -x LidAwake 2>/dev/null || true
  pkill -x "Lid Awake" 2>/dev/null || true
  rm -rf "$MENUBAR_APP_PATH"
  mkdir -p "$MENUBAR_APP_PATH/Contents/MacOS" "$MENUBAR_APP_PATH/Contents/Resources/Assets"
  cp "$build_dir/LidAwake" "$MENUBAR_APP_PATH/Contents/MacOS/LidAwake"
  cp "$build_dir/LidAwake.icns" "$MENUBAR_APP_PATH/Contents/Resources/LidAwake.icns"
  cp "$build_dir/lid-awake.svg" "$MENUBAR_APP_PATH/Contents/Resources/Assets/"
  cp "$build_dir/Info.plist" "$MENUBAR_APP_PATH/Contents/Info.plist"

  codesign --force --deep --sign - "$MENUBAR_APP_PATH" 2>/dev/null || true
  rm -rf "$build_dir"
  trap - EXIT

  open "$MENUBAR_APP_PATH"

  echo ""
  echo "✅ Lid Awake is in the menu bar"
  echo "   Look for the coffee-cup icon."
  echo "   Remove it anytime with: lid-awake menubar disable"
}

menubar_disable() {
  if ! menubar_is_enabled; then
    echo "The menu bar app is not enabled."
    return 0
  fi
  pkill -x LidAwake 2>/dev/null || true
  pkill -x "Lid Awake" 2>/dev/null || true
  "$MENUBAR_APP_PATH/Contents/MacOS/LidAwake" unregister 2>/dev/null || true
  "$MENUBAR_APP_PATH/Contents/MacOS/Lid Awake" unregister 2>/dev/null || true
  rm -rf "$MENUBAR_APP_PATH"
  echo "✅ Lid Awake menu bar disabled and removed."
}

menubar_cmd() {
  case "${1:-}" in
    enable) menubar_enable ;;
    disable) menubar_disable ;;
    help|-h|--help|"") menubar_usage ;;
    *)
      menubar_usage >&2
      exit 1
      ;;
  esac
}

[[ "$(uname -s)" == "Darwin" ]] || die "lid-awake only runs on macOS"

command -v pmset >/dev/null || die "pmset not found"

case "${1:-toggle}" in
  on) enable_awake; maybe_notify_update ;;
  off) disable_awake; maybe_notify_update ;;
  status)
    show_status "${2:-}"
    [[ "${2:-}" == "--porcelain" ]] || maybe_notify_update
    ;;
  update) update_cmd "${2:-}" ;;
  menubar) menubar_cmd "${2:-}" ;;
  toggle)
    if is_on; then disable_awake; else enable_awake; fi
    maybe_notify_update
    ;;
  version|-v|--version) echo "lid-awake ${VERSION}" ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac

# Stop here: an update renames a new copy over this file mid-run.
exit
